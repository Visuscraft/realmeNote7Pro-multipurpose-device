# Default configuration for the realme Note 7 Pro multipurpose device.
#
# Every value can be overridden by exporting the variable before running any
# script, or by editing "$DEVICE_HOME/config.env" on the device itself.

# GitHub repository that publishes the releases.
DEVICE_REPO="${DEVICE_REPO:-Visuscraft/realmeNote7Pro-multipurpose-device}"

# Branch that hosts latest.json.
DEVICE_BRANCH="${DEVICE_BRANCH:-main}"

# Where the manifest describing the newest release is published.
DEVICE_MANIFEST_URL="${DEVICE_MANIFEST_URL:-https://raw.githubusercontent.com/${DEVICE_REPO}/${DEVICE_BRANCH}/latest.json}"

# Root directory of the installation on the device.
DEVICE_HOME="${DEVICE_HOME:-$HOME/.realme-device}"

# Seconds between two update checks when the updater runs in watch mode.
DEVICE_UPDATE_INTERVAL="${DEVICE_UPDATE_INTERVAL:-300}"

# Mode started automatically after boot or after an update.
DEVICE_MODE="${DEVICE_MODE:-idle}"

# Port used by the local dashboard.
DEVICE_DASHBOARD_PORT="${DEVICE_DASHBOARD_PORT:-8080}"

# Number of previous releases kept on disk for rollback.
DEVICE_KEEP_RELEASES="${DEVICE_KEEP_RELEASES:-3}"

# How deploy/debloat.sh talks to the Android package manager:
# "root" (su), "adb" (wireless debugging) or "direct". Empty = auto-detect.
DEVICE_DEBLOAT_BACKEND="${DEVICE_DEBLOAT_BACKEND:-}"

# Lists used by deploy/debloat.sh. Point them at your own copies to keep a
# device specific selection.
DEVICE_BLOATWARE_LIST="${DEVICE_BLOATWARE_LIST:-}"
DEVICE_SERVICES_LIST="${DEVICE_SERVICES_LIST:-}"
